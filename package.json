{
  "name": "leanring-react-javascript",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=1536 ./node_modules/vite/bin/vite.js build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:component": "vitest run --config vitest.config.js",
    "mobile:start": "npm run start --workspace=@jimpitan/mobile",
    "mobile:android": "npm run android --workspace=@jimpitan/mobile",
    "mobile:build:low-memory": "npm run android:build:low-memory --workspace=@jimpitan/mobile",
    "mobile:typecheck": "npm run typecheck --workspace=@jimpitan/mobile"
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "html2canvas": "^1.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.23",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.4",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.6",
    "vitest": "^5.0.5"
  }
}
