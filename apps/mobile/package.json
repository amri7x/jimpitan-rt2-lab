{
  "name": "@jimpitan/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_NO_METRO_WORKSPACE_ROOT=1 NODE_PATH=./node_modules expo start --dev-client",
    "android": "expo run:android",
    "android:build:low-memory": "cd android && CMAKE_BUILD_PARALLEL_LEVEL=1 ./gradlew :app:assembleDebug --no-daemon --max-workers=1 -PreactNativeArchitectures=${MOBILE_ABI:-arm64-v8a}",
    "postinstall": "node ./scripts/link-nativewind-tailwind.cjs",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jimpitan/core": "*",
    "@react-native-firebase/app": "^27.1.1",
    "@react-native-firebase/auth": "^27.1.1",
    "@react-native-firebase/database": "^27.1.1",
    "expo": "~57.0.32",
    "expo-constants": "~57.0.23",
    "expo-dev-client": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.30",
    "expo-sharing": "~57.0.7",
    "nativewind": "^4.2.7",
    "react": "19.2.7",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  }
}
